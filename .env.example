# ---- Database (PostgreSQL) ----
# ตัวอย่าง Neon / Vercel Postgres / Supabase connection string
DATABASE_URL="postgresql://user:password@host:5432/condostock?sslmode=require"

# ---- Auth.js (NextAuth) ----
# สร้างด้วยคำสั่ง: npx auth secret  หรือ  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Vercel Blob (เก็บรูปห้อง) ----
# ได้จาก Vercel Dashboard > Storage > Blob
# ถ้าเว้นว่างไว้ตอน dev ระบบจะเก็บรูปลงโฟลเดอร์ public/uploads แทน
BLOB_READ_WRITE_TOKEN=""

# ---- Seed admin (ใช้ตอนรัน prisma db seed) ----
SEED_ADMIN_EMAIL="admin@condostock.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="Admin"

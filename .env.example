# ---- Database (PostgreSQL) ----
# ตัวอย่าง Neon / Vercel Postgres / Supabase connection string
DATABASE_URL="postgresql://user:password@host:5432/condostock?sslmode=require"

# ---- Auth.js (NextAuth) ----
# สร้างด้วยคำสั่ง: npx auth secret  หรือ  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- ที่เก็บรูปห้อง ----
# ระบบเลือก backend อัตโนมัติ:
#  - Netlify: ใช้ Netlify Blobs อัตโนมัติ (ไม่ต้องตั้งค่าใด ๆ)
#  - Vercel:  ตั้ง BLOB_READ_WRITE_TOKEN (จาก Vercel Dashboard > Storage > Blob)
#  - dev เครื่องตัวเอง: ถ้าไม่ตั้งค่าอะไร จะเก็บลงโฟลเดอร์ public/uploads
BLOB_READ_WRITE_TOKEN=""

# ---- (ไม่บังคับ) URL เว็บ สำหรับโหลดฟอนต์ไทยตอนสร้าง PDF ----
# Netlify/Vercel ตั้งให้อัตโนมัติแล้ว ระบุเองเฉพาะกรณีใช้โดเมนของตัวเอง
# NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"

# ---- Seed admin (ใช้ตอนรัน prisma db seed) ----
SEED_ADMIN_EMAIL="admin@condostock.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_ADMIN_NAME="Admin"

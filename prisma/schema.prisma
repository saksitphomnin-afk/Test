generator client {
  provider      = "prisma-client-js"
  // native = เครื่อง dev, rhel-openssl-3.0.x = Netlify/AWS Lambda functions
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum RoomStatus {
  AVAILABLE // ว่าง
  RESERVED  // จอง
  RENTED    // เช่าแล้ว
  SOLD      // ขายแล้ว
}

enum ListingType {
  RENT // ให้เช่า
  SALE // ขาย
  BOTH // เช่า/ขาย
}

enum ContractType {
  RENT // สัญญาเช่า
  SALE // สัญญาซื้อขาย
}

enum CustomerStatus {
  NEW       // ใหม่
  CONTACTED // กำลังคุย
  CLOSED    // ปิดการขาย
  CANCELLED // ยกเลิก
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  // รหัสรันลูกค้า: อักษรย่อต่อคน (แอดมินตั้ง) + ตัวนับต่อคน → เช่น SP-0001 (3 account ไม่ชนกัน)
  customerPrefix String?
  customerSeq    Int     @default(0)

  createdRooms     Room[]      @relation("RoomCreatedBy")
  remarkLogs       RemarkLog[]
  createdContracts Contract[]
  customers        Customer[]  @relation("CustomerCreatedBy")
}

model Room {
  id          String      @id @default(cuid())
  projectName String // ชื่อโครงการ
  tower       String? // ตึก/อาคาร
  roomNumber  String // เลขห้อง
  floor       String? // ชั้น
  sizeSqm     Float? // ขนาด (ตร.ม.)
  roomType    String? // ประเภทห้อง เช่น 1 Bedroom
  ownerName   String // ชื่อเจ้าของ
  ownerPhone  String // เบอร์โทรเจ้าของ
  ownerLineId String? // Line ID เจ้าของ
  listingType ListingType @default(RENT)
  saleType    String? // ประเภทการขาย เช่น ขายดาวน์ / มือ 1 / มือ 2 / เช่า
  salePrice   Float? // ราคาขาย
  rentPrice   Float? // ค่าเช่า/เดือน
  status      RoomStatus  @default(AVAILABLE)
  remark      String? // Remark ปัจจุบัน (ล่าสุด)

  createdById String
  createdBy   User   @relation("RoomCreatedBy", fields: [createdById], references: [id])

  images     RoomImage[]
  remarkLogs RemarkLog[]
  contracts  Contract[]
  stations   RoomStation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([projectName])
}

// รถไฟฟ้าใกล้เคียง — 1 ห้องมีได้หลายสถานี, ระยะห่าง (เมตร) กรอกเอง (ดูจาก Google Maps)
model RoomStation {
  id             String @id @default(cuid())
  roomId         String
  room           Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  station        String // รหัสสถานี อ้างอิง STATIONS ใน src/lib/stations.ts
  distanceMeters Int // ระยะห่างจากคอนโดถึงสถานี (เมตร)

  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([station])
}

model RoomImage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([roomId])
}

model RemarkLog {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([roomId])
}

// ลูกค้า/Enquiry — เป็นของแต่ละคนในทีม (member เห็นเฉพาะของตัวเอง, admin เห็นทั้งหมด)
model Customer {
  id        String         @id @default(cuid())
  code      String?        @unique // รหัสรันอัตโนมัติ เช่น SP-0001
  name      String // ชื่อลูกค้า
  phone     String // เบอร์โทร
  lineId    String? // Line ID
  budget    Int? // งบสูงสุด (บาท)
  note      String? // ความต้องการ/รายละเอียด
  status    CustomerStatus @default(NEW)

  createdById String
  createdBy   User   @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]

  @@index([createdById])
  @@index([phone])
}

model Contract {
  id          String       @id @default(cuid())
  roomId      String
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type        ContractType
  data        Json // ค่าฟิลด์ทั้งหมดในฟอร์มสัญญา

  // Phase 2: ผูกกับลูกค้า (Enquiry) + เงินจอง
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bookingPaid   Boolean   @default(false) // จ่ายเงินจองแล้วหรือยัง
  bookingAmount Int? // จำนวนเงินจอง (บาท)
  slipUrl       String? // สลิปการโอนเงินจอง

  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  furnitureItems FurnitureItem[]

  @@index([roomId])
  @@index([customerId])
}

enum FurnitureCategory {
  LIVING
  BEDROOM
  MASTER_BEDROOM
  KITCHEN
  BALCONY
  BATHROOM_1
  BATHROOM_2
}

// รูปเฟอร์นิเจอร์ + คำอธิบายทีละรูป ผูกกับสัญญา (ไม่ใช่ห้อง) เพราะสภาพเฟอร์นิเจอร์ต้องบันทึกใหม่
// ทุกครั้งที่มีผู้เช่า/ผู้ซื้อรายใหม่ ไม่ควรผูกค้างข้ามผู้เช่า
model FurnitureItem {
  id         String            @id @default(cuid())
  contractId String
  contract   Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  category   FurnitureCategory
  isDefect   Boolean           @default(false)
  caption    String            @default("")
  url        String
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())

  @@index([contractId])
}
